# Application
NODE_ENV=development
APP_NAME=SafeConnect Solutions
APP_PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=safeconnect_db
DB_USER=safeconnect_user
DB_PASSWORD=change_this_secure_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=change_this_to_a_very_long_random_secret_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_key_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png

# Email (for alerts and notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@safeconnect.com
EMAIL_PASSWORD=change_this_email_password
EMAIL_FROM=SafeConnect Security <noreply@safeconnect.com>

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Security
CSRF_SECRET=change_this_csrf_secret_key_min_32_chars
SESSION_SECRET=change_this_session_secret_key_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Monitoring
ENABLE_SECURITY_ALERTS=true
ALERT_EMAIL=security@safeconnect.com
FAILED_LOGIN_THRESHOLD=5
SUSPICIOUS_ACTIVITY_THRESHOLD=10

# Penetration Testing (only enable in test environment)
ENABLE_SECURITY_TESTING=false
